#! /bin/sh

# PROVIDE: hyperboria-route
# REQUIRE: networking
# KEYWORD: shutdown

# Add the following line to /etc/rc.conf to enable hyperboria-route:
# cjdroute_enable="YES"

. /etc/rc.subr

name="hyperboria-route"
rcvar="cjdroute_enable"

load_rc_config $name

: ${cjdroute_config:=/usr/local/etc/hyperboria-route.conf}

command="/usr/local/bin/hyperboria-route"
command_args=" < ${cjdroute_config}"

start_cmd="${name}_start"
stop_cmd="${name}_stop"

test ! -d /var/run/hyperboria-route/ && mkdir /var/run/hyperboria-route/

if_cjd="$(cat /usr/local/etc/hyperboria-route.conf | egrep -o '"tunDevice": "t[a,u][p,n][0-9]{1,2}"' | egrep -o 't[a,u][p,n][0-9]{1,2}')"

cjdroute_start() {
 test ! -f /usr/local/etc/hyperboria-route.conf && (
  logger -s -t hyperboria-route "Generate a configuration in /usr/local/etc/hyperboria-route.conf"
  exit 1
 )
 if [ "$if_cjd" = "" ]; then logger -s -t hyperboria-route "Tunnel adapter not found. Specify adapter name in hyperboria-route.conf."; exit 1; fi
 /sbin/ifconfig $if_cjd >/dev/null 2>&1
 if [ "$?" = 0 ] ; then ifconfig $if_cjd destroy; fi
 /sbin/ifconfig $if_cjd create || logger -s -t hyperboria-route "Failed to create ${if_cjd} adapter"
 /usr/local/bin/hyperboria-route < /usr/local/etc/hyperboria-route.conf &
 /sbin/route -6 add fc00::/8 -iface $if_cjd
} 

cjdroute_stop() {
 logger -s -t hyperboria-route "Stopping hyperboria-route"
 if [ "$rc_pid" != "" ]; then
 kill -TERM $rc_pid ; fi
 /sbin/ifconfig $if_cjd >/dev/null 1>/dev/null 2>dev/null
 if [ "$?" = 0 ]; then /sbin/ifconfig $if_cjd destroy ||  logger -s -t hyperboria-route "Failed to destroy $if_cjd adapter"; fi
}

load_rc_config $name
: ${cjdroute_enable:=no}

run_rc_command "$1"
