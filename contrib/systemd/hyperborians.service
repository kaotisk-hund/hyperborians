[Unit]
Description=hyperboria: routing engine designed for security, scalability, speed and ease of use
Wants=network.target
After=network-pre.target
Before=network.target network.service

[Service]
ProtectHome=true
ProtectSystem=true
SyslogIdentifier=hyperboria-route
ExecStartPre=/bin/sh -ec "if ! test -s /etc/hyperboria-route.conf; \
                then umask 077; \
                /usr/bin/hyperboria-route --genconf > /etc/hyperboria-route.conf; \
                echo 'WARNING: A new /etc/hyperboria-route.conf file has been generated.'; \
            fi"
ExecStartPre=-/sbin/ip -6 route add blackhole fc00::/8 metric 500
ExecStart=/bin/sh -c "exec /usr/bin/hyperboria-route --nobg < /etc/hyperboria-route.conf"
Restart=always

[Install]
WantedBy=multi-user.target
Also=hyperborians-resume.service
